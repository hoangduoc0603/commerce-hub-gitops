{
  "uid": "service-overview",
  "title": "Service overview",
  "description": "RED, JVM, pool DB của một service (G0-30, N12). Chọn service ở biến trên cùng. Chuẩn: docs/standards/observability.md. Dashboard dạng code: sửa ở gitops/infra/kube-prometheus-stack/dashboards/service-overview.json, không sửa trên UI.",
  "tags": [
    "commerce-hub",
    "service"
  ],
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "links": [
    {
      "title": "Cardinality",
      "type": "dashboards",
      "tags": [
        "cardinality"
      ],
      "asDropdown": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{container=\"app\", endpoint=\"management\"}, service)",
          "refId": "service"
        },
        "definition": "label_values(up{container=\"app\", endpoint=\"management\"}, service)",
        "description": "Service do chart app triển khai: target có container app và endpoint management (ServiceMonitor của chart).",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "RED: request, lỗi, độ trễ (không tính probe /livez, /readyz)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request mỗi giây theo route",
      "description": "Rate của http_server_requests_seconds_count theo nhãn uri (mẫu route, không phải ID). Probe của kubelet bị loại để chỉ thấy traffic thật.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/livez|/readyz\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tỷ lệ lỗi",
      "description": "Phần request có outcome SERVER_ERROR (5xx) và CLIENT_ERROR (4xx) trên tổng. 4xx thường là token sai hay dữ liệu sai, 5xx là lỗi của service.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/livez|/readyz\", outcome=\"SERVER_ERROR\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/livez|/readyz\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/livez|/readyz\", outcome=\"CLIENT_ERROR\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/livez|/readyz\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Độ trễ p50, p95, p99 (có exemplar)",
      "description": "histogram_quantile trên bucket cộng mọi pod (sum by le), nên gộp đúng khi có nhiều replica. Chấm exemplar trên p99 mang trace_id: bấm để mở trace trên Tempo.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"$service\", uri!~\"/livez|/readyz\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"$service\", uri!~\"/livez|/readyz\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"$service\", uri!~\"/livez|/readyz\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bộ nhớ JVM",
      "description": "Heap và non-heap đang dùng, và heap tối đa (-XX:MaxRAMPercentage của chart). Heap sát max sau GC là dấu hiệu rò rỉ hoặc thiếu RAM.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (area) (jvm_memory_used_bytes{service=\"$service\"})",
          "legendFormat": "{{area}} đang dùng",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{service=\"$service\", area=\"heap\"})",
          "legendFormat": "heap tối đa",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Thời gian dừng vì GC",
      "description": "Giây dừng vì GC trên mỗi giây chạy, theo loại GC. 0.05 nghĩa là 5% thời gian app đứng chờ GC.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_sum{service=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{gc}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU và thread",
      "description": "process_cpu_usage là phần CPU của cả máy mà JVM dùng (0–1, theo số CPU JVM thấy: ActiveProcessorCount của chart). Thread sống ở trục phải.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(process_cpu_usage{service=\"$service\"})",
          "legendFormat": "CPU process",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_threads_live_threads{service=\"$service\"})",
          "legendFormat": "thread sống",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "thread sống"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Pool kết nối DB (Hikari) và truy vấn JDBC",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kết nối Hikari",
      "description": "active: đang cho mượn; idle: rảnh; pending: thread đang chờ kết nối. pending > 0 kéo dài là pool hoặc PgBouncer đã cạn.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (hikaricp_connections_active{service=\"$service\"})",
          "legendFormat": "active {{pool}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (hikaricp_connections_idle{service=\"$service\"})",
          "legendFormat": "idle {{pool}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (hikaricp_connections_pending{service=\"$service\"})",
          "legendFormat": "pending {{pool}}",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (hikaricp_connections_max{service=\"$service\"})",
          "legendFormat": "max {{pool}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Thời gian chờ lấy kết nối",
      "description": "Trung bình thời gian getConnection() phải chờ pool (sum/count), và số lần hết hạn chờ mỗi giây (hikaricp_connections_timeout_total).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hikaricp_connections_acquire_seconds_sum{service=\"$service\"}[$__rate_interval])) / sum(rate(hikaricp_connections_acquire_seconds_count{service=\"$service\"}[$__rate_interval]))",
          "legendFormat": "chờ trung bình",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hikaricp_connections_timeout_total{service=\"$service\"}[$__rate_interval]))",
          "legendFormat": "timeout/s",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Truy vấn JDBC",
      "description": "Timer jdbc_query_seconds của datasource-micrometer: thời gian trung bình theo thao tác và bảng (nhãn semconv db_operation_name, db_collection_name). Câu chậm thì tìm trace trên Tempo theo span DB.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_operation_name, db_collection_name) (rate(jdbc_query_seconds_sum{service=\"$service\"}[$__rate_interval])) / sum by (db_operation_name, db_collection_name) (rate(jdbc_query_seconds_count{service=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{db_operation_name}} {{db_collection_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
